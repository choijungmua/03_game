schema: design.v1
name: ggpli
version: 0.2.0
status: bootstrap
updated_at: "2026-09-14"
description: "Dark-first shadcn foundation with the reusable ZMZM component architecture adapted for ggpli."

$schema: https://raw.githubusercontent.com/AgentsORG/DESIGN/main/schema/design.v1.schema.json

agent:
  skill: design
  instructions: |
    This file is the living visual contract for this repository.
    READ it before generating, reviewing, or restyling UI.
    FOLLOW its tokens, constraints, component catalog, voice, and shadcn integration; do not create a parallel design system.
    UPDATE it in place when the user approves a design decision, bumping SemVer and updated_at. Ask before changing locked paths.
    VERIFY tokens against app/globals.css, shadcn settings against components.json, and catalog entries against real components.
    PRECEDENCE: user request, then this file, then the design skill, then generic design guidance, then model defaults.
    Prefer existing shadcn components and semantic tokens. Never hardcode a value when a matching token exists.

overview: |
  The repository uses a dark-first, blue-accented product foundation adapted from the local ZMZM reference.
  Shared UI is grouped by role, while route-only UI belongs in colocated _components folders.
  Game-specific art direction remains intentionally undecided.

intent:
  reference: "ZMZM's restrained Korean product UI structure adapted to a dark shadcn base-nova foundation"
  direction: dark-product-foundation
  signature: "Cool blue interaction accents on quiet charcoal surfaces."
  treatment: utilitarian
  density: comfortable
  trust: high
  energy: low
  playfulness: low

voice:
  register: "Plain, concise Korean. Direct and helpful without decorative wording."
  casing: sentence
  action_naming: "Use specific action labels instead of generic labels such as Continue."
  errors: "State what happened and provide the next recovery action."

targets:
  - web

tokens:
  color:
    background: "oklch(1 0 0)"
    foreground: "oklch(0.145 0 0)"
    card: "oklch(1 0 0)"
    card-foreground: "oklch(0.145 0 0)"
    popover: "oklch(1 0 0)"
    popover-foreground: "oklch(0.145 0 0)"
    primary: "oklch(0.707 0.165 254.624)"
    primary-foreground: "oklch(0.145 0 0)"
    secondary: "oklch(0.97 0 0)"
    secondary-foreground: "oklch(0.205 0 0)"
    muted: "oklch(0.97 0 0)"
    muted-foreground: "oklch(0.556 0 0)"
    accent: "oklch(0.97 0 0)"
    accent-foreground: "oklch(0.205 0 0)"
    destructive: "oklch(0.577 0.245 27.325)"
    border: "oklch(0.922 0 0)"
    input: "oklch(0.922 0 0)"
    ring: "oklch(0.708 0 0)"
  typography:
    body:
      fontFamily: ["Pretendard", "system-ui", "sans-serif"]
      fontSize: 16
      fontWeight: 400
      lineHeight: 1.5
    control:
      fontFamily: ["Pretendard", "system-ui", "sans-serif"]
      fontSize: 14
      fontWeight: 500
      lineHeight: 1.25
  spacing:
    unit: 4
  radius:
    base: "0.625rem"
    sm: "calc(0.625rem * 0.6)"
    md: "calc(0.625rem * 0.8)"
    lg: "0.625rem"
  motion:
    properties: [color, background-color, border-color, box-shadow, opacity, transform]
    reduced_motion: required

locked:
  - integrations.shadcn.base
  - integrations.shadcn.preset
  - integrations.shadcn.base_color
  - integrations.shadcn.css_variables

components:
  button:
    import: "@/components/ui/button"
    description: "Base UI button generated by the shadcn base-nova preset."
    when: ["user-triggered actions", "form submission"]
    when_not: ["navigation; use Link or anchor", "non-interactive decoration"]
    variants: [default, outline, secondary, ghost, destructive, link]
    sizes: [default, xs, sm, lg, icon, icon-xs, icon-sm, icon-lg]
    states: [default, hover, active, focus-visible, disabled, aria-invalid]
  zmzm-library:
    import: "@/components"
    description: "Role-grouped reusable UI adapted from the local ZMZM design-system source."
    when: ["shared inputs", "display surfaces", "feedback", "navigation", "overlays"]
    when_not: ["route-specific compositions; colocate those under the route _components folder"]
    groups: [inputs, display, feedback, navigation, overlay]
    entries: [avatar, badge, button, card, carousel, checkbox, dialog, dropdown-menu, fab, form, input, label, loading, pagination, popover, progress, skeleton, sonner, tabs, tooltip]

policy:
  if_missing: ask
  hierarchy: [typography, spacing, contrast, color]
  reuse:
    prefer_existing_components: true
  accessibility:
    focus_visible: required
    reduced_motion: honor
    keyboard: required

decisions:
  component_source:
    - if: "a suitable component exists under @/components/ui"
      then: { action: reuse_or_extend, source: "@/components/ui" }
    - if: "a suitable shadcn component exists but is not installed"
      then: { action: add_with_shadcn_cli }
  navigation:
    - if: "the interaction changes location"
      then: { element: "Next.js Link or anchor" }

constraints:
  always:
    - read this file before UI work
    - use semantic color tokens
    - preserve visible focus and keyboard operation
    - support reduced motion
    - verify mobile, laptop, and ultra-wide layouts
  never:
    - invent product branding without user direction
    - hardcode colors when a semantic token exists
    - "transition: all"
    - disable browser zoom
    - use clickable divs or spans
    - use color as the only status cue

themes:
  default: dark
  modes:
    light:
      tokens:
        color:
          background: "oklch(1 0 0)"
          foreground: "oklch(0.145 0 0)"
    dark:
      tokens:
        color:
          background: "oklch(0.145 0 0)"
          foreground: "oklch(0.985 0 0)"
          card: "oklch(0.205 0 0)"
          card-foreground: "oklch(0.985 0 0)"
          popover: "oklch(0.205 0 0)"
          popover-foreground: "oklch(0.985 0 0)"
          primary: "oklch(0.707 0.165 254.624)"
          primary-foreground: "oklch(0.145 0 0)"
          secondary: "oklch(0.269 0 0)"
          secondary-foreground: "oklch(0.985 0 0)"
          muted: "oklch(0.269 0 0)"
          muted-foreground: "oklch(0.708 0 0)"
          accent: "oklch(0.269 0 0)"
          accent-foreground: "oklch(0.985 0 0)"
          destructive: "oklch(0.704 0.191 22.216)"
          border: "oklch(1 0 0 / 10%)"
          input: "oklch(1 0 0 / 15%)"
          ring: "oklch(0.556 0 0)"

integrations:
  shadcn:
    enabled: true
    style: nova
    base: base
    preset: base-nova
    icon_library: lucide
    css_variables: true
    base_color: neutral
    css: app/globals.css
    components_json: ./components.json
    rsc: true
    tsx: true
    aliases:
      components: "@/components"
      utils: "@/lib/utils"
      ui: "@/components/ui"
      lib: "@/lib"
      hooks: "@/hooks"
    registries: {}
    components: [button]
    radius: "0.625rem"
    map_from_tokens:
      background: tokens.color.background
      foreground: tokens.color.foreground
      primary: tokens.color.primary
      primary-foreground: tokens.color.primary-foreground
      secondary: tokens.color.secondary
      secondary-foreground: tokens.color.secondary-foreground
      muted: tokens.color.muted
      muted-foreground: tokens.color.muted-foreground
      accent: tokens.color.accent
      accent-foreground: tokens.color.accent-foreground
      destructive: tokens.color.destructive
      border: tokens.color.border
      input: tokens.color.input
      ring: tokens.color.ring

sources:
  - type: repo
    path: app/globals.css
  - type: repo
    path: components.json
  - type: repo
    path: components/ui/button.tsx
  - type: repo
    path: components/index.ts
  - type: local-reference
    path: C:/Users/user/Desktop/project/99_Archive/95_zmzm/src/components

provenance:
  owner: project
  last_reviewed: "2026-09-14"

omitted:
  - section: assets
    reason: "Pretendard is the only approved design asset; product imagery and game art do not exist yet."
  - section: patterns
    reason: "No product screens or composition patterns are approved yet."
  - section: rationale
    reason: "The current contract records infrastructure, not a product visual direction."
